<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Knockout Stage - UCL Simulator</title>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <div class="ucl-container">
      <h1 class="page-title">Knockout Stage</h1>

      <% if (!isSeasonStarted) { %>
      <div class="empty-state">
        <p>No matches played yet. Run the league stage first to unlock playoff brackets.</p>
        <a href="/league" class="btn btn-accent">Go to League Phase</a>
      </div>
      <% } else { %>

      <section class="knockout-card">
        <h2 class="card-header">⭐ Direct Round of 16 Qualifiers (1-8)</h2>
        <div class="team-grid">
          <% directQualified.forEach((team, index) => { %>
          <div class="badge-card badge-success">
            <div class="badge-info">
              <span class="team-title"><%= team.name %></span>
              <span class="team-meta"><%= team.points %> Pts | <%= team.goalsFor - team.goalsAgainst %> GD</span>
            </div>
            <span class="badge-rank">#<%= index + 1 %></span>
          </div>
          <% }); %>
        </div>
      </section>

      <section class="knockout-card">
        <h2 class="card-header">⚔️ Play-off Phase (9-24)</h2>
        <div class="action-row">
          <% if (playoffMatches.length === 0) { %>
          <form action="/knockout/generate-playoffs" method="POST">
            <button type="submit" class="btn btn-accent">Generate Play-off Matches</button>
          </form>
          <% } else { %>
          <form action="/knockout/simulate-stage" method="POST">
            <input type="hidden" name="stage" value="PLAYOFF" />
            <button type="submit" class="btn btn-accent">Simulate Play-offs</button>
          </form>
          <% } %>
        </div>

        <div class="fixture-grid">
          <% playoffMatches.forEach(match => { %>
          <div class="fixture-card">
            <span class="team-name text-right <%= match.winner && match.winner._id.toString() === match.homeTeam._id.toString() ? 'winner' : '' %>">
              <%= match.homeTeam.name %>
            </span>
            <div class="score-pill">
              <% if (match.played) { %>
                <%= match.homeScore %> - <%= match.awayScore %>
                <% if (match.penaltyHome !== null) { %>
                  <small>(P: <%= match.penaltyHome %>-<%= match.penaltyAway %>)</small>
                <% } %>
              <% } else { %>
                <small>Leg <%= match.leg %></small>
              <% } %>
            </div>
            <span class="team-name text-left <%= match.winner && match.winner._id.toString() === match.awayTeam._id.toString() ? 'winner' : '' %>">
              <%= match.awayTeam.name %>
            </span>
          </div>
          <% }); %>
        </div>
      </section>

      <section class="knockout-card">
        <h2 class="card-header">🔥 Round of 16</h2>
        <div class="action-row">
          <% if (roundOf16Matches.length === 0) { %>
          <form action="/knockout/generate-round-of-16" method="POST">
            <button type="submit" class="btn btn-accent">Draw Round of 16</button>
          </form>
          <% } else { %>
          <form action="/knockout/simulate-stage" method="POST">
            <input type="hidden" name="stage" value="ROUND_OF_16" />
            <button type="submit" class="btn btn-accent">Simulate Round of 16</button>
          </form>
          <% } %>
        </div>

        <div class="fixture-grid">
          <% roundOf16Matches.forEach(match => { %>
          <div class="fixture-card">
            <span class="team-name text-right <%= match.winner && match.winner._id.toString() === match.homeTeam._id.toString() ? 'winner' : '' %>">
              <%= match.homeTeam.name %>
            </span>
            <div class="score-pill">
              <% if (match.played) { %>
                <%= match.homeScore %> - <%= match.awayScore %>
                <% if (match.penaltyHome !== null) { %>
                  <small>(P: <%= match.penaltyHome %>-<%= match.penaltyAway %>)</small>
                <% } %>
              <% } else { %>
                <small>Leg <%= match.leg %></small>
              <% } %>
            </div>
            <span class="team-name text-left <%= match.winner && match.winner._id.toString() === match.awayTeam._id.toString() ? 'winner' : '' %>">
              <%= match.awayTeam.name %>
            </span>
          </div>
          <% }); %>
        </div>
      </section>

      <section class="knockout-card">
        <h2 class="card-header">🏆 Quarter-Finals</h2>
        <div class="action-row">
          <% if (quarterMatches.length === 0) { %>
          <form action="/knockout/generate-quarter" method="POST">
            <button type="submit" class="btn btn-accent">Draw Quarter-Finals</button>
          </form>
          <% } else { %>
          <form action="/knockout/simulate-stage" method="POST">
            <input type="hidden" name="stage" value="QUARTER_FINAL" />
            <button type="submit" class="btn btn-accent">Simulate Quarter-Finals</button>
          </form>
          <% } %>
        </div>

        <div class="fixture-grid">
          <% quarterMatches.forEach(match => { %>
          <div class="fixture-card">
            <span class="team-name text-right <%= match.winner && match.winner._id.toString() === match.homeTeam._id.toString() ? 'winner' : '' %>">
              <%= match.homeTeam.name %>
            </span>
            <div class="score-pill">
              <% if (match.played) { %> <%= match.homeScore %> - <%= match.awayScore %> <% } else { %> <small>Leg <%= match.leg %></small> <% } %>
            </div>
            <span class="team-name text-left <%= match.winner && match.winner._id.toString() === match.awayTeam._id.toString() ? 'winner' : '' %>">
              <%= match.awayTeam.name %>
            </span>
          </div>
          <% }); %>
        </div>
      </section>

      <section class="knockout-card">
        <h2 class="card-header">✨ Semi-Finals</h2>
        <div class="action-row">
          <% if (semiMatches.length === 0) { %>
          <form action="/knockout/generate-semi" method="POST">
            <button type="submit" class="btn btn-accent">Draw Semi-Finals</button>
          </form>
          <% } else { %>
          <form action="/knockout/simulate-stage" method="POST">
            <input type="hidden" name="stage" value="SEMI_FINAL" />
            <button type="submit" class="btn btn-accent">Simulate Semi-Finals</button>
          </form>
          <% } %>
        </div>

        <div class="fixture-grid">
          <% semiMatches.forEach(match => { %>
          <div class="fixture-card">
            <span class="team-name text-right <%= match.winner && match.winner._id.toString() === match.homeTeam._id.toString() ? 'winner' : '' %>">
              <%= match.homeTeam.name %>
            </span>
            <div class="score-pill">
              <% if (match.played) { %> <%= match.homeScore %> - <%= match.awayScore %> <% } else { %> <small>Leg <%= match.leg %></small> <% } %>
            </div>
            <span class="team-name text-left <%= match.winner && match.winner._id.toString() === match.awayTeam._id.toString() ? 'winner' : '' %>">
              <%= match.awayTeam.name %>
            </span>
          </div>
          <% }); %>
        </div>
      </section>

      <!-- FINAL SECTION -->
      <section class="knockout-card card-gold">
        <h2 class="card-header" style="color: var(--ucl-gold);">👑 Grand Final</h2>
        <div class="action-row">
          <% if (!finalMatch) { %>
          <form action="/knockout/generate-final" method="POST">
            <button type="submit" class="btn btn-accent">Generate Final</button>
          </form>
          <% } else if (!finalMatch.played) { %>
          <form action="/knockout/simulate-stage" method="POST">
            <input type="hidden" name="stage" value="FINAL" />
            <button type="submit" class="btn btn-accent">Simulate Final Match</button>
          </form>
          <% } %>
        </div>

        <% if (finalMatch) { %>
        <div class="fixture-card final-card">
          <span class="team-name text-right <%= finalMatch.winner && finalMatch.winner._id.toString() === finalMatch.homeTeam._id.toString() ? 'winner' : '' %>">
            <%= finalMatch.homeTeam.name %>
          </span>
          <div class="score-pill final-score">
            <% if (finalMatch.played) { %>
              <%= finalMatch.homeScore %> - <%= finalMatch.awayScore %>
              <% if (finalMatch.penaltyHome !== null) { %>
                <small>(P: <%= finalMatch.penaltyHome %>-<%= finalMatch.penaltyAway %>)</small>
              <% } %>
            <% } else { %>
              VS
            <% } %>
          </div>
          <span class="team-name text-left <%= finalMatch.winner && finalMatch.winner._id.toString() === finalMatch.awayTeam._id.toString() ? 'winner' : '' %>">
            <%= finalMatch.awayTeam.name %>
          </span>
        </div>

        <% if (finalMatch.winner) { %>
        <div class="trophy-box">
          <h3>🎉 CHAMPIONS LEAGUE WINNER 🎉</h3>
          <h1><%= finalMatch.winner.name %></h1>
        </div>
        <% } %>
        <% } %>
      </section>

      <!-- ELIMINATED TEAMS SECTION -->
      <section class="knockout-card">
        <h2 class="card-header" style="color: var(--ucl-danger);">❌ Eliminated Teams (25-36)</h2>
        <div class="team-grid">
          <% eliminatedTeams.forEach((team, index) => { %>
          <div class="badge-card badge-danger">
            <div class="badge-info">
              <span class="team-title"><%= team.name %></span>
              <span class="team-meta"><%= team.points %> Pts</span>
            </div>
            <span class="badge-rank">#<%= index + 25 %></span>
          </div>
          <% }); %>
        </div>
      </section>

      <% } %>
    </div>

    <%- include('partials/footer') %>

    <style>
      .knockout-card {
        background-color: var(--ucl-surface);
        border: 1px solid var(--ucl-card-border);
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 32px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      }

      .card-gold {
        border-color: rgba(251, 191, 36, 0.4);
        background: radial-gradient(circle at top, rgba(251, 191, 36, 0.05) 0%, var(--ucl-surface) 80%);
      }

      .card-header {
        font-size: 1.3rem;
        font-weight: 800;
        margin-bottom: 20px;
        color: var(--ucl-accent);
      }

      .action-row {
        margin-bottom: 20px;
      }

      .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 16px;
      }

      .badge-card {
        background-color: var(--ucl-card);
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-left: 4px solid transparent;
      }

      .badge-success { border-left-color: var(--ucl-success); }
      .badge-danger { border-left-color: var(--ucl-danger); opacity: 0.65; }

      .badge-info {
        display: flex;
        flex-direction: column;
      }

      .team-title {
        font-weight: 700;
        font-size: 0.95rem;
      }

      .team-meta {
        font-size: 0.8rem;
        color: var(--ucl-text-muted);
      }

      .badge-rank {
        font-weight: 800;
        font-size: 0.85rem;
        color: var(--ucl-text-muted);
      }

      .fixture-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
      }

      .fixture-card {
        background-color: var(--ucl-card);
        border: 1px solid var(--ucl-card-border);
        border-radius: 10px;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .team-name {
        width: 38%;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .text-right { text-align: right; }
      .text-left { text-align: left; }

      .score-pill {
        background-color: var(--ucl-bg);
        border: 1px solid var(--ucl-card-border);
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 800;
        font-size: 0.9rem;
        text-align: center;
        min-width: 70px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .winner {
        color: var(--ucl-accent);
        font-weight: 800;
        text-shadow: 0 0 8px var(--ucl-accent-glow);
      }

      .final-card {
        padding: 24px;
        border: 2px solid var(--ucl-gold);
      }

      .final-score {
        font-size: 1.2rem;
        padding: 10px 20px;
      }

      .trophy-box {
        text-align: center;
        margin-top: 24px;
        padding: 30px;
        background: linear-gradient(180deg, rgba(251, 191, 36, 0.1) 0%, rgba(0,0,0,0) 100%);
        border: 1px solid var(--ucl-gold);
        border-radius: 12px;
      }

      .trophy-box h3 {
        color: var(--ucl-gold);
        margin-bottom: 8px;
        font-size: 1rem;
        letter-spacing: 2px;
      }

      .trophy-box h1 {
        font-size: 2.2rem;
        font-weight: 900;
        margin: 0;
      }

      .empty-state {
        background-color: var(--ucl-surface);
        border: 1px solid var(--ucl-card-border);
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
      }

      .empty-state p {
        color: var(--ucl-text-muted);
        font-size: 1.1rem;
        margin-bottom: 24px;
      }
    </style>
  </body>
</html>