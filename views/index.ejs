<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UCL Simulator</title>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="hero-section">
      <div class="ucl-container">
        <div class="hero-card">
          <div class="glow-orb"></div>
          <h1 class="hero-title">UEFA Champions League</h1>
          <p class="hero-subtitle">
            Experience the revolution of football tournament engines. Simulate
            the Swiss-System league phase and dynamic knockout brackets in
            real-time.
          </p>
          <form action="/start-season" method="POST">
            <button type="submit" class="btn btn-accent btn-hero">
              🚀 Launch New Season
            </button>
          </form>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>

    <style>
      .hero-section {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
      }

      .hero-card {
        position: relative;
        background: linear-gradient(
          145deg,
          var(--ucl-surface) 0%,
          var(--ucl-card) 100%
        );
        border: 1px solid var(--ucl-card-border);
        border-radius: 20px;
        padding: 60px 40px;
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      }

      .glow-orb {
        position: absolute;
        top: -50%;
        left: 50%;
        transform: translateX(-50%);
        width: 300px;
        height: 300px;
        background: radial-gradient(
          circle,
          var(--ucl-accent-glow) 0%,
          rgba(0, 0, 0, 0) 70%
        );
        pointer-events: none;
      }

      .hero-title {
        font-size: 3rem;
        font-weight: 900;
        margin-bottom: 16px;
        background: linear-gradient(135deg, #ffffff 0%, var(--ucl-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-subtitle {
        color: var(--ucl-text-muted);
        font-size: 1.15rem;
        line-height: 1.6;
        margin-bottom: 32px;
      }

      .btn-hero {
        font-size: 1.1rem;
        padding: 16px 36px;
        border-radius: 12px;
      }
    </style>
  </body>
</html>
