<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UEFA Champions League Simulator</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>

    <div class="container" style="text-align: center; margin-top: 80px">
      <h1 class="page-title">UEFA Champions League Simulator</h1>
      <p
        style="
          color: var(--ucl-text-muted);
          margin-bottom: 30px;
          font-size: 1.2rem;
        "
      >
        Simulate the UEFA Champions League season using the new 36-team Swiss
        System format.
      </p>

      <form action="/start-season" method="POST">
        <button
          type="submit"
          class="btn btn-accent"
          style="font-size: 1.1rem; padding: 14px 32px"
        >
          Start New Season
        </button>
      </form>
    </div>
  </body>
</html>
